###############################################################################
#    AuctionHouseBot.ListingStack.RandomRatio.*
#        用于确定发布时该类别物品是单个还是随机堆叠的频率
#        值需要在0到100之间，无小数。高于100的值将被视为100
#       示例:    100 = 堆叠大小始终随机
#                50 = 一半时间堆叠随机，另一半时间为单个堆叠
#                0 = 堆叠始终为单个
#       默认值:    消耗品: 50 (50%随机堆叠大小, 50%单个堆叠)
#                容器: 0 (100%单个堆叠)
#                武器: 0 (100%单个堆叠)
#                宝石: 5 (5%随机堆叠, 95%单个堆叠)
#                护甲: 0 (100%单个堆叠)
#                材料: 50 (50%随机堆叠, 50%单个堆叠)
#                弹药: 100 (100%随机堆叠)
#                贸易品: 50 (50%随机堆叠, 50%单个堆叠)
#                通用: 100 (100%随机堆叠)
#                配方: 0 (100%单个堆叠)
#                箭袋: 0 (100%单个堆叠)
#                任务物品: 10 (10%随机堆叠, 90%单个堆叠)
#                钥匙: 10 (10%随机堆叠, 90%单个堆叠)
#                杂项: 100 (100%随机堆叠)
#                雕文: 0 (100%单个堆叠)
#
#    AuctionHouseBot.ListingStack.RandomStackIncrement.*
#        随机堆叠时，这是堆叠大小使用的倍数
#       示例:    1 = 堆叠大小为1, 2, 3, ...
#                5 = 堆叠大小为5, 10, 15, ...
#       设置过高的值将限制为最大堆叠大小，因此如果您希望所有随机堆叠都是满堆叠(如弹药)，
#        可以使用该值。此外，只有在随机堆叠'掷骰'成功时才会使用增量。值为0将被视为1
#
#       注意: 如果RandomRatio未设置为100，将出现堆叠大小为1的情况。
#        如果您希望某物始终发布最大堆叠，请将RandomRatio设置为100，
#        并将RandomStackIncrement设置为等于或大于该类别最大可能堆叠大小的值。
#        默认配置将为弹药执行此操作。
#
#    AuctionHouseBot.ListingStack.MaxStackSize.*
#        计算时构建堆叠的最大大小。如果为0，则没有自定义限制，将按物品允许的最大堆叠。
#        注意，这不会让您设置大于核心服务器或物品最大堆叠大小的最大堆叠大小
###############################################################################

AuctionHouseBot.ListingStack.RandomRatio.Consumable = 50
AuctionHouseBot.ListingStack.RandomRatio.Container = 0
AuctionHouseBot.ListingStack.RandomRatio.Weapon = 0
AuctionHouseBot.ListingStack.RandomRatio.Gem = 30
AuctionHouseBot.ListingStack.RandomRatio.Armor = 0
AuctionHouseBot.ListingStack.RandomRatio.Reagent = 50
AuctionHouseBot.ListingStack.RandomRatio.Projectile = 100
AuctionHouseBot.ListingStack.RandomRatio.TradeGood = 75
AuctionHouseBot.ListingStack.RandomRatio.Generic = 100
AuctionHouseBot.ListingStack.RandomRatio.Recipe = 0
